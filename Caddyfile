	auto_https disable_redirects
	https_port 4430

	gate {
		secret "gd0NcHq9CtemAxiUino3Mtj_rSeJC5k-Uz-tHnI-KKY"
		cookie_domain caddygate.com
		sign_in_url https://auth.caddygate.com:4430
