			zaphod "Zaphod" admin
			trillian "Trillan" admin audit
			marvin
		}
	}
}

auth.caddygate.com {
	tls internal
	gate serve {
		data_dir {$HOME}/.local/share/caddy/gate/caddygate.com
		default_next https://home.caddygate.com:4430
		rp {
			display_name "Caddygate Demo"
		}
	}
}

admin.caddygate.com {
	tls internal
	gate with admin
	respond "Welcome admin, you were successfully authorized."
}

audit.caddygate.com {
	tls internal
	gate with audit
	respond "Welcome audit, you were successfully authorized."
}

home.caddygate.com {
	tls internal
	gate
	respond "Welcome user, you were successfully authorized."
}
